# ---------------------------------------------------------------------------
# Barber Shop - variables de entorno
#
# Copiar este archivo a apps/web/.env.local y completar los valores.
# NUNCA versionar el .env.local: contiene credenciales.
# ---------------------------------------------------------------------------

# Modo demostracion -----------------------------------------------------
# Con `true`, la capa de datos devuelve un conjunto ficticio y no consulta
# Supabase. Permite recorrer el panel completo sin credenciales ni usuarios
# creados, y tomar capturas para el TCC sin exponer datos reales de clientes.
# La interfaz muestra un aviso permanente mientras esta activo.
NEXT_PUBLIC_MODO_DEMO=false

# Supabase --------------------------------------------------------------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tmuntxynyopzbhzmulux.supabase.co

# Clave publica (anon). Viaja al navegador; la proteccion real la dan las
# politicas RLS de la base, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. OMITE TODAS LAS POLITICAS RLS.
# Solo se usa en el servidor (apps/api) y jamas se expone al navegador.
# Por eso no lleva el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Aplicacion ------------------------------------------------------------
NEXT_PUBLIC_URL_SITIO=http://localhost:3000
NEXT_PUBLIC_ZONA_HORARIA=America/Asuncion

# Notificaciones por correo (RN-050, pendiente) -------------------------
RESEND_API_KEY=
CORREO_REMITENTE=no-responder@barbershop.com.py

# Microservicio de recomendaciones (CU-013, pendiente) ------------------
URL_SERVICIO_ML=http://localhost:5000
