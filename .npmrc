# Las dependencias de un paquete no quedan disponibles para otros por accidente.
# Obliga a declarar en cada package.json lo que realmente se usa.
strict-peer-dependencies=false
auto-install-peers=true

# Next.js necesita alcanzar sus dependencias transitivas.
node-linker=isolated
shamefully-hoist=false
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
